# 이 파일을 .env로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# 실제 값은 팀 채널이 아닌 개별 전달로 받습니다. .env는 절대 커밋하지 마세요.

# ─────────────────────────────────────────
# Cloud SQL (PostgreSQL + pgvector)
# ─────────────────────────────────────────
DB_NAME=edutech
DB_USER=app_user
DB_PASSWORD=

# 로컬 개발용 (Cloud SQL Proxy 경유)
# 1) brew install cloud-sql-proxy
# 2) gcloud auth application-default login
# 3) cloud-sql-proxy $INSTANCE_CONNECTION_NAME --port 5432
#    → "Ready for new connections"가 뜨면 이 터미널은 켜둔 채로 둡니다
DB_HOST=127.0.0.1
DB_PORT=5432

# <프로젝트ID>:<리전>:<인스턴스명> 형식
INSTANCE_CONNECTION_NAME=

# ─────────────────────────────────────────
# Gemini API
# ─────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=